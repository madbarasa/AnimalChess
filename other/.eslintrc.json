{
  "env": {
    "browser": true,
    "es2021": true
  },
  "globals": {
    "AnimalChessConfig": "readonly",
    "AnimalChessRules": "readonly",
    "AnimalChessAiEngine": "readonly",
    "AnimalChessRenderer": "readonly",
    "AnimalChessGameState": "readonly"
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off"
  }
}
